--- buildroot/support/docker/Dockerfile
+++ buildroot/support/docker/Dockerfile
@@ -71,12 +71,32 @@
         subversion \
         unzip \
         wget \
+        # Tezuka packages \
+        zip \
+        libclang-dev \
+        libssl-dev \
+        # xxd: U-Boot CONFIG_USE_DEFAULT_ENV_FILE (set by uboot-env-hook.mk) \
+        # generates defaultenv_autogenerated.h with it. nodejs/npm: \
+        # post-build.sh runs Dashboard/bundle.py, which npm-installs \
+        # esbuild. xilinx-bootgen: prepost-image.sh probes host-bootgen \
+        # with "-help", which exits 1 even when it works, so the system \
+        # bootgen is always the one used. The rest ship on GitHub runners \
+        # for free, so CI never caught them missing here. \
+        xxd \
+        nodejs \
+        npm \
+        xilinx-bootgen \
+        gawk \
+        lzop \
+        bison \
+        flex \
+        device-tree-compiler \
         && \
     apt-get -y autoremove && \
     apt-get -y clean
 
 # Build host-tar
-RUN curl -sfL https://ftpmirror.gnu.org/tar/tar-${TAR_VERSION}.tar.xz | \
+RUN curl -sfL https://ftp.gnu.org/gnu/tar/tar-${TAR_VERSION}.tar.xz | \
     tar -Jx -C /tmp && \
     cd /tmp/tar-${TAR_VERSION} && \
     FORCE_UNSAFE_CONFIGURE=1 ./configure \
@@ -89,6 +109,9 @@
 RUN sed -i 's/# \(en_US.UTF-8\)/\1/' /etc/locale.gen && \
     /usr/sbin/locale-gen
 
+# Hide git warnings about safety
+RUN git config --global --add safe.directory '*'
+
 RUN useradd -ms /bin/bash br-user && \
     chown -R br-user:br-user /home/br-user
 

